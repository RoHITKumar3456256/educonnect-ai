# Backend Environment Variables
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Gemini API (optional - system falls back gracefully to semantic heuristic extraction if not provided)
GEMINI_API_KEY=

# Supabase PostgreSQL (optional - system defaults to high-speed local SQLite database if not provided)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

